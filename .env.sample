
# Your Twilio Workflow SID.
TWILIO_WORKFLOW_SID = WWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Conference Mode Configuration
# Set to true to use conference mode with an outbound AI participant
# Set to false to use direct ConversationRelay (no conference)
USE_CONFERENCE=false

# Outbound call numbers for conference participants (REQUIRED if USE_CONFERENCE=true)
# OUTBOUND_TO should be a Twilio number that returns ConversationRelay TwiML
# OUTBOUND_FROM is the caller ID used for the outbound call
OUTBOUND_TO=+1xxxxxxxxxx
OUTBOUND_FROM=+1xxxxxxxxxx

# Your ngrok domain.
NGROK_DOMAIN=

# Your Welcome Greeting.
WELCOME_GREETING="Thanks for calling .... How can I help you today?"  

# LLM Configuration
# Supported providers: openai, anthropic, custom
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
LLM_STREAMING=true

# Embedding Configuration
# Supported providers: openai, anthropic, huggingface, custom
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-ada-002
EMBEDDING_BATCH_SIZE=512
EMBEDDING_DIMENSIONS=1536

# OpenAI API Key (required if using OpenAI provider)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API Key (required if using Anthropic provider)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace API Token (required if using HuggingFace provider)
HUGGINGFACEHUB_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
