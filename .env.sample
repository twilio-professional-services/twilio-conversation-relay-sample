
# Your Twilio Workflow SID.
TWILIO_WORKFLOW_SID = WWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Conference Mode Configuration
# Set to true to use conference mode with an outbound AI participant
# Set to false to use direct ConversationRelay (no conference)
USE_CONFERENCE=false

# Outbound participant configuration for conference (REQUIRED if USE_CONFERENCE=true)
# Option 1: Use TwiML App (recommended - no PSTN charges)
#   Configure your TwiML App's Voice URL to: https://your-domain/api/outbound-leg-answer
#   Format: app:APxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Option 2: Use PSTN phone number
#   Format: +1xxxxxxxxxx
OUTBOUND_TO=app:APxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OUTBOUND_FROM is the caller ID for the outbound leg
OUTBOUND_FROM=+1xxxxxxxxxx

# Outbound Calling Configuration
# Enable or disable AMD (Answering Machine Detection) for outbound calls
ENABLE_OUTBOUND_AMD=true
# AMD timeout in milliseconds (how long to wait for AMD to complete)
AMD_TIMEOUT=5000
# Minimum speech duration (ms) to detect a human vs machine
AMD_SPEECH_THRESHOLD=2400
# Speech end threshold (ms) for AMD
AMD_SPEECH_END_THRESHOLD=1200
# Default voicemail message to play when machine is detected
VOICEMAIL_MESSAGE="Hello, this is ABC Health System. We attempted to reach you regarding your account. Please call us back at your earliest convenience. Thank you."
# Caller ID for outbound calls (if different from OUTBOUND_FROM)
OUTBOUND_CALLER_ID=+1234567890

# Your ngrok domain.
NGROK_DOMAIN=

# Your Welcome Greeting.
WELCOME_GREETING="Thanks for calling .... How can I help you today?"  

# LLM Configuration
# Supported providers: openai, anthropic, custom
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
LLM_STREAMING=true

# Embedding Configuration
# Supported providers: openai, anthropic, huggingface, custom
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-ada-002
EMBEDDING_BATCH_SIZE=512
EMBEDDING_DIMENSIONS=1536

# OpenAI API Key (required if using OpenAI provider)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API Key (required if using Anthropic provider)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace API Token (required if using HuggingFace provider)
HUGGINGFACEHUB_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
