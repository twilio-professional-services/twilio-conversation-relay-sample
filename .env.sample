# ========================================
# Twilio Configuration
# ========================================

# Your Twilio Account SID (required)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token (required)
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Workflow SID (required)
TWILIO_WORKFLOW_SID=WWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio phone number for outbound calls (optional, can be passed in API request)
TWILIO_PHONE_NUMBER=+1234567890

# Your Twilio Conversational Intelligence Service SID (optional)
TWILIO_CONVERSATIONAL_INTELLIGENCE_SERVICE=GAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========================================
# Server Configuration
# ========================================

# Your ngrok domain (required for webhooks)
NGROK_DOMAIN=your-domain.ngrok.dev

# Server port (optional, defaults to 3000)
PORT=3000

# ========================================
# Voice Configuration
# ========================================

# Welcome greeting for inbound calls (optional)
WELCOME_GREETING="Thanks for calling. How can I help you today?"

# ========================================
# LLM Configuration
# ========================================

# LLM Provider: openai, anthropic, google, or azure-openai (optional, defaults to openai)
LLM_PROVIDER=openai

# Model name override (optional, uses provider-specific defaults if not set)
# OpenAI default: gpt-3.5-turbo
# Anthropic default: claude-haiku-4-5-20251001
# Google default: gemini-2.0-flash-001
LLM_MODEL_NAME=

# LLM Temperature (optional)
LLM_TEMPERATURE=0.9

# LLM Max Tokens (optional)
LLM_MAX_TOKENS=1000

# ========================================
# LLM API Keys (provide the key for your chosen provider)
# ========================================

# OpenAI API Key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API Key (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google API Key (required if LLM_PROVIDER=google)
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure OpenAI Configuration (required if LLM_PROVIDER=azure-openai)
AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_API_DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_API_VERSION=2024-04-01-preview
# Use either AZURE_OPENAI_ENDPOINT or AZURE_OPENAI_API_INSTANCE_NAME (not both)
AZURE_OPENAI_ENDPOINT=https://your-instance-name.cognitiveservices.azure.com/
# AZURE_OPENAI_API_INSTANCE_NAME=your-instance-name
